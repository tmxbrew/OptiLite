# Normalización de texto: el repositorio guarda LF, PowerShell exige CRLF
* text=auto

# OptiLite.ps1 DEBE conservar CRLF y BOM UTF-8 (PowerShell 5.1 + acentos)
*.ps1 text eol=crlf

